rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == "mrwanalhm38@gmail.com" && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins registry
    match /admins/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isOwnerAdmin());
      allow write: if isOwnerAdmin();
    }

    // Public restaurant settings (e.g. delivery fee)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isOwnerAdmin();
    }

    // Daily order counters for atomic sequence generation.
    // Customers may only start a day at #1 or bump the counter by exactly one.
    match /daily_counters/{dateString} {
      allow read: if true;
      allow create: if request.resource.data.dateString == dateString &&
                       request.resource.data.lastOrderNumber == 1;
      allow update: if isOwnerAdmin() || (
                       request.resource.data.dateString == resource.data.dateString &&
                       request.resource.data.lastOrderNumber == resource.data.lastOrderNumber + 1);
      allow delete: if isOwnerAdmin();
    }

    // Orders collection
    match /orders/{orderId} {
      // Customer data (name, phone, address) is only readable by the admin
      allow get, list: if isOwnerAdmin();
      allow create: if request.resource.data.orderNumber is int &&
                       request.resource.data.orderNumber > 0 &&
                       request.resource.data.totalAmount is number &&
                       request.resource.data.totalAmount >= 0 &&
                       request.resource.data.orderType in ['takeaway', 'delivery'] &&
                       request.resource.data.status == 'new' &&
                       request.resource.data.customerName is string &&
                       request.resource.data.customerName.size() > 0 &&
                       request.resource.data.customerName.size() <= 100 &&
                       request.resource.data.customerPhone is string &&
                       request.resource.data.customerPhone.size() <= 20 &&
                       request.resource.data.items is list &&
                       request.resource.data.items.size() > 0 &&
                       request.resource.data.items.size() <= 50;
      allow update: if isOwnerAdmin();
      allow delete: if isOwnerAdmin();
    }
  }
}
